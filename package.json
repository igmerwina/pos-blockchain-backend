{
  "name": "blockchainjs-whitepaper",
  "version": "2.0.0",
  "description": "Repo untuk kodingan tesis: Platform e-money berbasis Blockchain",
  "main": "index.js",
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "test": "jest --runInBand --reporters=default",
    "test:watch": "jest --watchAll",
    "build": "node scripts/vercel-build.js",
    "dev-test": "nodemon dev-test",
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "run-all": "node scripts/run-all.js",
    "simulate:nodes": "node scripts/simulate-nodes.js"
  },
  "jest": {
    "testEnvironment": "node",
    "modulePathIgnorePatterns": [
      "<rootDir>/.vercel"
    ],
    "reporters": [
      "default",
      [
        "./node_modules/jest-html-reporter",
        {
          "pageTitle": "Test: Platform e-money Blockchain based"
        }
      ]
    ]
  },
  "repository": {
    "type": "git",
    "url": "github.com/igmerwina/blockchainjs-whitepaper-.git"
  },
  "keywords": [],
  "author": "@igmerwina",
  "license": "ISC",
  "devDependencies": {
    "jest": "^30.5.1",
    "jest-html-reporter": "^4.4.0",
    "nodemon": "^1.18.11"
  },
  "dependencies": {
    "body-parser": "^2.3.0",
    "cors": "^2.8.5",
    "crypto-js": "^3.1.9-1",
    "elliptic": "^6.4.1",
    "express": "^5.2.1",
    "mongoose": "^5.7.0",
    "uuid": "^3.3.2",
    "ws": "^6.2.1"
  }
}
